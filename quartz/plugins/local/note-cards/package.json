{
  "name": "note-cards",
  "version": "0.1.0",
  "description": "Article cards with previews for the devtechblog.ru home page",
  "type": "module",
  "license": "MIT",
  "files": ["dist"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./components": { "types": "./dist/components/index.d.ts", "import": "./dist/components/index.js" },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": { "preact": "^10.0.0" },
  "dependencies": {
    "@quartz-community/types": "github:quartz-community/types"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "preact": "^10.28.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "engines": { "node": ">=22", "npm": ">=10.9.2" },
  "quartz": {
    "name": "note-cards",
    "displayName": "Note Cards",
    "category": "component",
    "version": "0.1.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {},
    "components": {
      "NoteCards": {
        "displayName": "Note Cards",
        "defaultPosition": "afterBody",
        "defaultPriority": 10
      }
    }
  }
}
